#!/usr/bin/env bash
#
# git-protect-branches — refuse direct commits on the named branches in this repo.
#
#   git-protect-branches master dev   protect master and dev
#   git-protect-branches              show what is protected
#   git-protect-branches --unset      protect nothing
#
# Sets `hook.protectBranches` in the repo's LOCAL config, which the global
# pre-commit hook in bborbe/dotfiles reads. Local on purpose: every worktree of
# the repo shares it, so protecting `dev` covers trading-dev as well as trading,
# and a global value is ignored by the hook — vaults autocommit on master.
#
# Merges still land: `git merge` runs pre-merge-commit, never pre-commit, so a
# deploy worktree's `git fetch && git merge origin/master` keeps working while a
# hand-commit on the protected branch is refused.

set -o errexit
set -o nounset
set -o pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
	echo "git-protect-branches: not inside a git repository" >&2
	exit 1
fi

case "${1:-}" in
	"")
		current=$(git config --local --get hook.protectBranches || true)
		echo "protected: ${current:-none}"
		;;
	--unset)
		git config --local --unset hook.protectBranches || true
		echo "protected: none"
		;;
	-h|--help)
		sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//'
		;;
	-*)
		echo "git-protect-branches: unknown option '$1'" >&2
		exit 2
		;;
	*)
		git config --local hook.protectBranches "$*"
		echo "protected: $*"
		;;
esac
