#!/usr/bin/env python3
"""Snapshot every running Claude Code session and where it lives in WezTerm.

Run this BEFORE a reboot. It writes:

  ~/.claude/wezterm-session-snapshot.json   machine-readable snapshot
  ~/.claude/wezterm-restore.sh              executable script that re-creates
                                            the windows/tabs and resumes each
                                            session by UUID

Data sources (no guessing):
  wezterm cli list --format json   window/tab/pane + tty per pane
  ps -eo pid,tty,command           tty -> claude pid, and which cc-* vault
  ~/.claude/sessions/<pid>.json    pid -> sessionId + cwd + session name

Sessions whose tty is not a WezTerm pane (other terminal app, detached) are
still captured, under window "-".
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys
from datetime import datetime

SNAPSHOT = os.path.expanduser("~/.claude/wezterm-session-snapshot.json")
RESTORE = os.path.expanduser("~/.claude/wezterm-restore.sh")

# Absolute, because `wezterm cli spawn` inherits the GUI process env, whose PATH
# may not contain this repo — a bare `cc-personal` would fail to spawn.
SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))

# mcp-obsidian-<vault>.json on the claude command line -> launcher in this repo
LAUNCHERS = {
    "personal": "cc-personal",
    "brogrammers": "cc-brogrammers",
    "boss": "cc-boss",
    "openbrain": "cc-openbrain",
}


def launcher_for(vault):
    name = LAUNCHERS.get(vault)
    return os.path.join(SCRIPTS_DIR, name) if name else "claude"


def wezterm_panes():
    """tty name (without /dev/) -> pane record. Empty dict if wezterm is absent."""
    try:
        out = subprocess.run(
            ["wezterm", "cli", "list", "--format", "json"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return {}
    return {p["tty_name"].replace("/dev/", ""): p for p in json.loads(out)}


def claude_processes():
    """pid -> (tty, full command line) for every interactive claude process."""
    out = subprocess.run(["ps", "-eo", "pid=,tty=,command="], capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(ttys\d+)\s+(claude\s.*)", line)
        if m:
            procs[int(m.group(1))] = (m.group(2), m.group(3))
    return procs


def collect():
    panes = wezterm_panes()
    procs = claude_processes()
    rows = []
    for path in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            s = json.load(open(path))
        except (OSError, ValueError):
            continue
        pid = s.get("pid")
        if pid not in procs:
            continue  # stale file, process is gone
        tty, cmd = procs[pid]
        pane = panes.get(tty)
        m = re.search(r"mcp-obsidian-(\w+)\.json", cmd)
        vault = m.group(1) if m else None
        rows.append({
            "window": pane["window_id"] if pane else None,
            "tab": pane["tab_id"] if pane else None,
            "pane": pane["pane_id"] if pane else None,
            "tty": tty,
            "pid": pid,
            "vault": vault,
            "launcher": launcher_for(vault),
            "cwd": s.get("cwd"),
            "session": s.get("sessionId"),
            "name": s.get("name") or (pane["title"] if pane else ""),
        })
    rows.sort(key=lambda r: (r["window"] if r["window"] is not None else 999, r["tab"] or 0))
    return rows


def print_table(rows):
    if not rows:
        print("No running Claude Code sessions found.")
        return
    print(f'{"win":>3} {"tab":>4} {"tty":<8} {"vault":<12} {"session-uuid":<36}  name')
    for r in rows:
        win = "-" if r["window"] is None else str(r["window"])
        tab = "-" if r["tab"] is None else str(r["tab"])
        print(f'{win:>3} {tab:>4} {r["tty"]:<8} {str(r["vault"]):<12} {r["session"]:<36}  {r["name"]}')


def write_restore(rows):
    """Emit a restore script: one WezTerm window per original window, tabs in order."""
    groups = {}
    for r in rows:
        groups.setdefault(r["window"], []).append(r)

    out = [
        "#!/usr/bin/env bash",
        "# Generated by wezterm-claude-snapshot on "
        + datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "# Re-creates the WezTerm windows/tabs and resumes each Claude session by UUID.",
        "# Re-running spawns duplicates — run once, after the reboot.",
        "set -euo pipefail",
        "",
    ]
    for window, items in sorted(groups.items(), key=lambda kv: (kv[0] is None, kv[0])):
        label = "detached (was not a WezTerm pane)" if window is None else f"window {window}"
        out += [f"# --- {label} — {len(items)} session(s) ---"]
        for i, r in enumerate(items):
            cmd = f'{r["launcher"]} --resume {r["session"]}'
            out.append(f'# {r["name"]}')
            if i == 0:
                out.append(f'PANE=$(wezterm cli spawn --new-window --cwd {r["cwd"]} -- {cmd})')
                out.append(
                    'WIN=$(wezterm cli list --format json | '
                    'python3 -c "import json,sys;p=int(sys.argv[1]);'
                    'print(next(x[\'window_id\'] for x in json.load(sys.stdin) '
                    'if x[\'pane_id\']==p))" "$PANE")'
                )
            else:
                out.append(f'wezterm cli spawn --window-id "$WIN" --cwd {r["cwd"]} -- {cmd}')
        out.append("")
    text = "\n".join(out) + "\n"
    with open(RESTORE, "w") as fh:
        fh.write(text)
    os.chmod(RESTORE, 0o755)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--json", action="store_true", help="print JSON instead of a table")
    args = ap.parse_args()

    rows = collect()
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        print_table(rows)

    with open(SNAPSHOT, "w") as fh:
        json.dump({"takenAt": datetime.now().isoformat(), "sessions": rows}, fh, indent=2)
    write_restore(rows)

    if not args.json:
        print()
        print(f"snapshot: {SNAPSHOT}")
        print(f"restore : {RESTORE}   (run once after reboot)")
    return 0 if rows else 1


if __name__ == "__main__":
    sys.exit(main())
