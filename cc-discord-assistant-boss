#!/usr/bin/env bash
# Launcher for the BOSS identity of discord-assistant.
#
# See cc-discord-assistant-personal for why this is a launcher rather than an
# `mcp_config:` entry, and why the MCP set is deliberately small.
#
# Deliberately NOT cc-boss: same vault and same effort level, but a smaller MCP
# set. Boss keeps the trading servers because its job is oversight over trading
# state; it does not get browser, vision, or the tts server.

set -euo pipefail

ulimit -n 8000

export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export MCP_REMOTE_CONFIG_DIR="$HOME/.mcp-personal"
export ANTHROPIC_BASE_URL="${CLAUDE_CODE_ROUTER_URL:-http://127.0.0.1:8788}"
export ANTHROPIC_MODEL="claude-opus-5[1m]"
export EFFORT_LEVEL="high"
export PERMISSION_MODE="auto"

VAULT="${OBSIDIAN_BOSS:-$HOME/Documents/Obsidian/Boss}"

cd "$VAULT" || exit 1

claude \
--model "${ANTHROPIC_MODEL}" \
--effort "${EFFORT_LEVEL}" \
--permission-mode "${PERMISSION_MODE}" \
--mcp-config "$HOME/.claude/mcp-discord-assistant-boss.json" \
--strict-mcp-config \
--add-dir "$VAULT" \
--add-dir /tmp \
"$@"
