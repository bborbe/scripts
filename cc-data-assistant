#!/usr/bin/env bash
# Launcher for the DATA ASSISTANT identity — Google Chat + Discord surfaces.
#
# One assistant, two surfaces. The working vault is its OWN runtime vault
# (obsidian-data-assistant); the Brogrammers vault is mounted READ-ONLY
# knowledge — write capability is removed by the shim's allowed_tools (no
# Edit/Write), so nothing under Brogrammers can ever be mutated.

set -euo pipefail

ulimit -n 8000

export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export MCP_REMOTE_CONFIG_DIR="$HOME/.mcp-data-assistant"
export ANTHROPIC_BASE_URL="${CLAUDE_CODE_ROUTER_URL:-http://127.0.0.1:8788}"
export ANTHROPIC_MODEL="claude-opus-5[1m]"
export EFFORT_LEVEL="medium"
export PERMISSION_MODE="auto"

VAULT="${OBSIDIAN_DATA_ASSISTANT:-$HOME/Documents/Obsidian/DataAssistant}"
VAULT_BROGRAMMERS="${OBSIDIAN_BROGRAMMERS:-$HOME/Documents/Obsidian/Brogrammers}"

cd "$VAULT" || exit 1


# Persist transcripts even when spawned from a child/branched session
unset CLAUDE_CODE_CHILD_SESSION
# A spawned pane inherits the CALLING session's CLAUDE_CODE_SESSION_ID, so it
# resolves its own name from the PARENT and ends its run carrying the parent's
# name (measured 3x 2026-09-14: ae186815, f4c8fd2d, a4de4005). No-op on a plain launch.
unset CLAUDE_CODE_SESSION_ID
export CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1
claude \
--settings '{"theme":"custom:private-blue"}' \
--model "${ANTHROPIC_MODEL}" \
--effort "${EFFORT_LEVEL}" \
--permission-mode "${PERMISSION_MODE}" \
--mcp-config "$HOME/.claude/mcp-data-assistant.json" \
--strict-mcp-config \
--add-dir "$VAULT" \
--add-dir "$VAULT_BROGRAMMERS" \
--add-dir /tmp \
"$@"
