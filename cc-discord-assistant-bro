#!/usr/bin/env bash
# Launcher for the BROGRAMMERS identity of discord-assistant.
#
# See cc-discord-assistant-personal for why this is a launcher rather than an
# `mcp_config:` entry, and why the MCP set is deliberately small.
#
# This instance is team-facing (all Brogrammers on the allowlist once the k8s
# deploy is green), so the --add-dir set is scoped to the team's THREE vaults
# and nothing else — no ~/Documents/workspaces, no Personal vault. The k8s pod
# mounts the same three vaults under /vault; this launcher is the laptop
# equivalent.
#
# Runtime home is the dedicated BrogrammersAssistant vault (since 2026-09-09,
# mirroring the personal assistant's move off the user vault): its own
# CLAUDE.md carries no narration rule and its MCP set excludes tts, so a
# Discord-answered session can never double-speak on the laptop. The three
# team vaults below are knowledge reached via --add-dir, never the cwd.

set -euo pipefail

ulimit -n 8000

export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export MCP_REMOTE_CONFIG_DIR="$HOME/.mcp-brogrammers"
export ANTHROPIC_BASE_URL="${CLAUDE_CODE_ROUTER_URL:-http://127.0.0.1:8788}"
# Routed through claude-code-router on 127.0.0.1:8788; deepseek-* requests
# forward to vllm.seibert.tools with the provider token swapped at the router
# (see ~/.config/claude-code-router/config.yaml). Switch mid-session with
# `/model <name>`.
export ANTHROPIC_DEFAULT_FABLE_MODEL="deepseek-v4-flash-max[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-flash-max[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-flash[1m]"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash[1m]"
export EFFORT_LEVEL="high" # low, medium, high, xhigh
export PERMISSION_MODE="auto"

VAULT="${OBSIDIAN_BROGRAMMERS_ASSISTANT:-$HOME/Documents/Obsidian/BrogrammersAssistant}"
VAULT_BROGRAMMERS="${OBSIDIAN_BROGRAMMERS:-$HOME/Documents/Obsidian/Brogrammers}"
VAULT_AGENT="${OBSIDIAN_AGENT:-$HOME/Documents/Obsidian/OctopusAgent}"
VAULT_OPENBRAIN="${OBSIDIAN_OPENBRAIN:-$HOME/Documents/Obsidian/OpenBrain}"

cd "$VAULT" || exit 1


# Persist transcripts even when spawned from a child/branched session
unset CLAUDE_CODE_CHILD_SESSION
export CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1
claude \
--settings '{"theme":"custom:private-blue"}' \
--model "${ANTHROPIC_DEFAULT_OPUS_MODEL}" \
--effort "${EFFORT_LEVEL}" \
--permission-mode "${PERMISSION_MODE}" \
--mcp-config "$HOME/.claude/mcp-discord-assistant-bro.json" \
--strict-mcp-config \
--add-dir "$VAULT" \
--add-dir "$VAULT_BROGRAMMERS" \
--add-dir "$VAULT_AGENT" \
--add-dir "$VAULT_OPENBRAIN" \
--add-dir /tmp \
"$@"
